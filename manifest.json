{
  "manifest_version": 3,
  "name": "Chrome Profile Guard",
  "version": "1.0.0",
  "description": "Lock your browsing workspace with a PIN or password. Auto-locks after inactivity and on restart. Everything stays on this device.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Chrome Profile Guard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "pages/settings/settings.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/guard.js"],
      "css": ["content/guard.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "quick-lock": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Lock the browsing workspace now"
    }
  },
  "permissions": [
    "storage",
    "idle",
    "webNavigation",
    "tabs",
    "scripting"
  ],
  "host_permissions": ["http://*/*", "https://*/*"]
}
